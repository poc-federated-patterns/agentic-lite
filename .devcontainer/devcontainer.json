{
  "name": "agentic-lite",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "pip install -r scripts/python/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-pull-request-github",
        "atlassian.atlascode",
        "redhat.vscode-yaml"
      ]
    }
  }
}


