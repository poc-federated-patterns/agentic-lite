#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_SCRIPTS="${REPO_ROOT}/scripts/python"

if [[ -f "${REPO_ROOT}/.venv/bin/activate" ]]; then
  source "${REPO_ROOT}/.venv/bin/activate"
fi

if [[ -f "${REPO_ROOT}/config/credentials.env" ]]; then
  set -a
  source "${REPO_ROOT}/config/credentials.env"
  set +a
fi

# Normalize GitHub token env var naming for different tools.
if [[ -n "${GH_TOKEN:-}" && -z "${GITHUB_TOKEN:-}" ]]; then
  export GITHUB_TOKEN="${GH_TOKEN}"
fi
if [[ -n "${GITHUB_TOKEN:-}" && -z "${GH_TOKEN:-}" ]]; then
  export GH_TOKEN="${GITHUB_TOKEN}"
fi

cd "${REPO_ROOT}"
python3 -c "
import sys
sys.path.insert(0, '${PYTHON_SCRIPTS}')
from cli import main
main()
" "$@"


